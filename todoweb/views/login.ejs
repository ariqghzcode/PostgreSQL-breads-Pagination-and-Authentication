<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <section class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
        <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
            <%- include('partials/alert')%>
            <div class="card-header text-center bg-white border-0 pt-4">
                <img src="/images/logo/rubicamp.png" alt="ini logo" width="200">
                <h1 class="fs-4 mt-3">Please sign in</h1>
            </div>
            <div class="card-body">
                <form action="/login" method="post">
                    <div class="mb-3">
                        <label for="email" class="visually-hidden">Email</label>
                        <input class="form-control" type="email" name="email" placeholder="Email address">
                    </div>
                    <div class="">
                        <label for="password" class="visually-hidden">Password</label>
                        <input class="form-control" type="password" name="password"
                            placeholder="Password">
                    </div>
                    <button class="btn btn-primary w-100 mt-3" type="submit">Sign In</button>
                </form>
            </div>
            <div class="card-footer text-center bg-white border-0 pb-4">
                <p class="mb-0">Don't have an account? please <a href="/register">Sign Up</a></p>
            </div>
        </div>
    </section>
</body>

</html>