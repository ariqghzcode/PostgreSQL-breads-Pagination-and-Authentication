<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container">
        <div class="card mt-3">
            <div class="card-header text-center">
                <h1>SQLite BREAD (Browse, Read, Edit, Add, Delete) and Pagination</h1>
            </div>
            <div class="card-body">
                <form action="" method="get">
                    <div class="row mb-3">
                        <label for="name" class="col-sm-2 col-form-label">Name</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="text" name="name" placeholder="insert your name"
                                value="<%= query.name %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="height" class="col-sm-2 col-form-label">Height</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="number" name="height" placeholder="insert your height"
                                value="<%= query.height %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="weight" class="col-sm-2 col-form-label">Weight</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="number" name="weight" placeholder="insert your weight"
                                step="0.1" value="<%= query.weight %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="birthdate" class="col-sm-2 col-form-label">Birth date</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="date" id="birthdate" name="birthdate"
                                value="<%= query.birthdate %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="isMarried" class="col-sm-2 col-form-label">Marital Status</label>
                        <div class="col-sm-10">
                            <select class="form-control" name="isMarried">
                                <option value="" disabled selected>have you married ?</option>
                                <option value="false" <%=query.isMarried==="false" ? ' selected' : '' %>>Not yet
                                </option>
                                <option value="true" <%=query.isMarried==="true" ? ' selected' : '' %>>yes</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn btn-success" type="submit">Search</button>
                    <a class="btn btn-warning" href="/">Reset</a>

                </form>
                <hr>
            </div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Name</th>
                        <th>Height</th>
                        <th>Weight</th>
                        <th>Birth Date</th>
                        <th>Is Married</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% rows.forEach(item=> { %>
                        <tr>
                            <td>
                                <%= item.id %>
                            </td>
                            <td>
                                <%= item.name %>
                            </td>
                            <td>
                                <%= item.height %>
                            </td>
                            <td>
                                <%= item.weight %>
                            </td>
                            <td>
                                <%= item.birthdate %>
                            </td>
                            <td>
                                <%= item.isMarried ? 'Yes' : 'Not yet' %>
                            </td>
                            <td><a class="btn btn-success" href="/edit/<%= item.id %>">Update</a> <a
                                    class="btn btn-danger" href="/delete/<%= item.id %>"
                                    onclick="return confirm('apakah anda yakin menghapus <%= item.id %>')">Delete</a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            
            <div class="card-footer d-flex justify-content-between align-items-center">
                <input type="button" value="Create" onclick="window.location.href='/add'" class="btn btn-primary">
            <nav aria-label="Page navigation example">
                <ul class="pagination mb-0">
                    <% if (page > 1){ %>
                    <li class="page-item">
                        <a class="page-link" href="/?<%= url.replace(`page=${page}`, `page=${page - 1}`) %>" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    <% } %>
                    <% for (let i = 1; i <= pages; i++) {%>
                    <li class="page-item<%= page == i ? ' active' : '' %>"><a class="page-link" href="/?<%= url.replace(`page=${page}`, `page=${i}`) %>"><%= i %></a></li>
                    <% } %>
                    <% if (page < pages){ %>
                    <li class="page-item">
                        <a class="page-link" href="/?<%= url.replace(`page=${page}`, `page=${page + 1}`) %>" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                    <% } %>
                </ul>
            </nav>
            </div>
        </div>
    </div>
    </div>
</body>

</html>