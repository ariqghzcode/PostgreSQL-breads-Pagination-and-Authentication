<%- include('../partials/header')%>
    <div class="container">
        <%- include('../partials/menu')%>
        <div class="card mt-3">
            <div class="card-header text-center">
                <h1>PostgreSQL Breads(Browse, Read, Edit, Add, Delete, Sort)</h1>
            </div>
            <div class="card-body">
                <form action="" method="get">
                    <div class="row mb-3">
                        <label for="name" class="col-sm-2 col-form-label">Name</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="text" name="name" placeholder="insert your name"
                                value="<%= query.name %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="height" class="col-sm-2 col-form-label">Height</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="number" name="height" placeholder="insert your height"
                                value="<%= query.height %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="weight" class="col-sm-2 col-form-label">Weight</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="number" name="weight" placeholder="insert your weight"
                                step="0.1" value="<%= query.weight %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="startdate" class="col-sm-2 col-form-label">Birth Date</label>
                        <div class="col-sm-4">
                            <input class="form-control" type="date" name="startdate" value="<%= query.startdate %>">
                        </div>
                        <label for="enddate" class="col-sm-1 col-form-label text-center">s.d.</label>
                        <div class="col-sm-4">
                            <input class="form-control" type="date" name="enddate" value="<%= query.enddate %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="ismarried" class="col-sm-2 col-form-label">Marital Status</label>
                        <div class="col-sm-10">
                            <select class="form-control" name="ismarried">
                                <option value="" disabled selected>have you married ?</option>
                                <option value="false" <%=query.ismarried==="false" ? ' selected' : '' %>>Not yet
                                </option>
                                <option value="true" <%=query.ismarried==="true" ? ' selected' : '' %>>yes</option>
                            </select>
                        </div>
                    </div>
                    
                    <button class="btn btn-success" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    <a class="btn btn-warning" href="/users"><i class="fa-solid fa-rotate"></i></a>

                </form>
                <hr>
            </div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th><a href="/users?<%= url.replace(`sortBy=${sortBy}`, `sortBy=name`).replace(`sortMode=${sortMode}`, `sortMode=${sortMode == 'asc' ? 'desc' : 'asc'}`) %>"><i class="fa-solid fa-<%= `${sortBy == 'name' ? sortMode == 'asc' ? 'sort-up' : 'sort-down' : 'sort'}` %>"></i>Name</a></th>
                        <th>Height</th>
                        <th>Weight</th>
                        <th>Birth Date</th>
                        <th>Is Married</th>
                        <th>Role</th>
                        <th>Avatar</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% rows.forEach(item=> { %>
                        <tr>
                            <td>
                                <%= item.id %>
                            </td>
                            <td>
                                <%= item.name %>
                            </td>
                            <td>
                                <%= item.height %>
                            </td>
                            <td>
                                <%= item.weight %>
                            </td>
                            <td>
                                <%= moment(item.birthdate).format("D MMMM YYYY") %>
                            </td>
                            <td>
                                <%= item.ismarried ? 'Yes' : 'Not yet' %>
                            </td>
                            <td>
                                <%= item.role %>
                            </td>
                            <td>
                                <img src="/images/avatars/<%= item.avatar || 'user.png' %>" alt="ini avatar" width="50">
                            </td>
                            <td><a class="btn btn-success" href="/users/edit/<%= item.id %>"><i class="fa-solid fa-pencil"></i></a>
                                <a class="btn btn-danger" href="/users/delete/<%= item.id %>"
                                    onclick="return confirm('apakah anda yakin menghapus <%= item.id %>')"><i class="fa-solid fa-trash"></i></a>
                                <a class="btn btn-warning" href="/users/upload/<%= item.id %>"><i class="fa-solid fa-circle-user"></i></a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>

            <div class="card-footer d-flex justify-content-end align-items-center">
                <nav aria-label="Page navigation example">
                    <ul class="pagination mb-0">
                        <% if (page> 1){ %>
                            <li class="page-item">
                                <a class="page-link" href="/users?<%= url.replace(`page=${page}`, `page=${page - 1}`) %>"
                                    aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            <% } %>
                                <% for (let i=1; i <=pages; i++) {%>
                                    <li class="page-item<%= page == i ? ' active' : '' %>"><a class="page-link"
                                            href="/users?<%= url.replace(`page=${page}`, `page=${i}`) %>">
                                            <%= i %>
                                        </a></li>
                                    <% } %>
                                        <% if (page < pages){ %>
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="/users?<%= url.replace(`page=${page}`, `page=${page + 1}`) %>"
                                                    aria-label="Next">
                                                    <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                            <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    
<%- include('../partials/footer')%>