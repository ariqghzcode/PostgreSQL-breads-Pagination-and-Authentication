<%- include('../partials/header')%>
    <div class="container">
        <%- include('../partials/menu')%>
            <div class="card mt-3">
                <div class="card-header text-center">
                    <h1>PostgreSQL Breads(Browse, Read, Edit, Add, Delete, Sort)</h1>
                </div>
                <div class="card-body">
                    <form action="" method="get">
                        <div class="row mb-3">
                            <label for="title" class="col-sm-2 col-form-label">Title</label>
                            <div class="col-sm-10">
                                <input class="form-control" type="text" name="title" placeholder="insert title"
                                    value="<%= query.title %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="startdate" class="col-sm-2 col-form-label">Deadline</label>
                            <div class="col-sm-4">
                                <input class="form-control" type="date" name="startdate" value="<%= query.startdate %>">
                            </div>
                            <label for="enddate" class="col-sm-1 col-form-label text-center">s.d.</label>
                            <div class="col-sm-4">
                                <input class="form-control" type="date" name="enddate" value="<%= query.enddate %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="complete" class="col-sm-2 col-form-label">Complete</label>
                            <div class="col-sm-10">
                                <select class="form-control" name="complete">
                                    <option value="" disabled selected>-select complete-</option>
                                    <option value="false" <%=query.complete==="false" ? ' selected' : '' %>>Not yet
                                    </option>
                                    <option value="true" <%=query.complete==="true" ? ' selected' : '' %>>Done</option>
                                </select>
                            </div>
                        </div>

                        <button class="btn btn-info" type="submit"><i
                                class="fa-solid fa-magnifying-glass"></i></button>
                        <a class="btn btn-warning" href="/todos"><i class="fa-solid fa-rotate"></i></a>

                    </form>
                    <hr>
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th><a
                                    href="/todos?<%= url.replace(`sortBy=${sortBy}`, `sortBy=title`).replace(`sortMode=${sortMode}`, `sortMode=${sortMode == 'asc' ? 'desc' : 'asc'}`) %>"><i
                                        class="fa-solid fa-<%= `${sortBy == 'title' ? sortMode == 'asc' ? 'sort-up' : 'sort-down' : 'sort'}` %>"></i>Title</a>
                            </th>
                            <th><a
                                    href="/todos?<%= url.replace(`sortBy=${sortBy}`, `sortBy=complete`).replace(`sortMode=${sortMode}`, `sortMode=${sortMode == 'asc' ? 'desc' : 'asc'}`) %>"><i
                                        class="fa-solid fa-<%= `${sortBy == 'complete' ? sortMode == 'asc' ? 'sort-up' : 'sort-down' : 'sort'}` %>"></i>Complete</a>
                            </th>
                            <th><a
                                    href="/todos?<%= url.replace(`sortBy=${sortBy}`, `sortBy=deadline`).replace(`sortMode=${sortMode}`, `sortMode=${sortMode == 'asc' ? 'desc' : 'asc'}`) %>"><i
                                        class="fa-solid fa-<%= `${sortBy == 'deadline' ? sortMode == 'asc' ? 'sort-up' : 'sort-down' : 'sort'}` %>"></i>Deadline</a>
                            </th>
                            <th>actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rows.forEach((item, index)=> { %>
                            <% const isOverdue=item.deadline && !item.complete &&
                                moment(item.deadline).isBefore(moment()) %>
                                <tr class="<%= isOverdue ? 'table-danger' : '' %>">
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= item.title %>
                                    </td>
                                    <td>
                                        <%= item.complete ? 'Done' : 'Not yet' %>
                                    </td>
                                    <td>
                                        <%= moment(item.deadline).format('D MMM YYYY HH:mm') %>
                                    </td>
                                    <td><a class="btn btn-success" href="/todos/edit/<%= item.id %>"><i class="fa-solid fa-pencil"></i></a>
                                        <a class="btn btn-danger" href="/todos/delete/<%= item.id %>"
                                            onclick="return confirm('apakah anda yakin menghapus <%= item.id %>')"><i class="fa-solid fa-trash"></i></a>
                                    </td>
                                </tr>
                                <% }) %>
                    </tbody>
                </table>

                <div class="card-footer d-flex justify-content-between align-items-center">
                    <a class="btn btn-primary btn-sm" href="/todos/add"><i class="fa-solid fa-plus"></i></a>
                    <nav aria-label="Page navigation example">
                        <ul class="pagination mb-0">
                            <% if (page> 1){ %>
                                <li class="page-item">
                                    <a class="page-link"
                                        href="/todos?<%= url.replace(`page=${page}`, `page=${page - 1}`) %>"
                                        aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                <% } %>
                                    <% for (let i=1; i <=pages; i++) {%>
                                        <li class="page-item<%= page == i ? ' active' : '' %>"><a class="page-link"
                                                href="/todos?<%= url.replace(`page=${page}`, `page=${i}`) %>">
                                                <%= i %>
                                            </a></li>
                                        <% } %>
                                            <% if (page < pages){ %>
                                                <li class="page-item">
                                                    <a class="page-link"
                                                        href="/todos?<%= url.replace(`page=${page}`, `page=${page + 1}`) %>"
                                                        aria-label="Next">
                                                        <span aria-hidden="true">&raquo;</span>
                                                    </a>
                                                </li>
                                                <% } %>
                        </ul>
                    </nav>
                </div>
            </div>
    </div>
    <%- include('../partials/footer')%>